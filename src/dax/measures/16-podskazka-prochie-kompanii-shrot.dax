Подсказка_прочие_компании_шрот =
"Всего "
&
IF(
    SELECTEDVALUE('Справка_экспортеры_прочее'[Компании]) = "ПРОЧЕЕ",
    CALCULATE(
        DISTINCTCOUNT('Справка_экспортеры_прочее'[Компании]),
        FILTER(
            ALL('Справка_экспортеры_прочее'[Компании]),
            RANKX(ALL('Справка_экспортеры_прочее'[Компании]), [Сумма_экспорт_шрот]) > 5
        )
    )-1 & " а, именно: ",
    BLANK()
)
&
IF(
    SELECTEDVALUE('Справка_экспортеры_прочее'[Компании]) = "ПРОЧЕЕ",
    CALCULATE(
        CONCATENATEX(
            ADDCOLUMNS(
                'Справка_экспортеры_прочее',
                "Без прочего",
                IF('Справка_экспортеры_прочее'[Компании] = "ПРОЧЕЕ", BLANK(), 'Справка_экспортеры_прочее'[Компании])
            ),
            [Без прочего],
            ", "
        ),
        FILTER(
            ALL('Справка_экспортеры_прочее'[Компании]),
            RANKX(ALL('Справка_экспортеры_прочее'[Компании]), [Сумма_экспорт_шрот]) > 5
        )
    ),
    BLANK()
)
