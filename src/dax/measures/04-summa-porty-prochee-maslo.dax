Сумма_порты_прочее_масло =
IF(
    SELECTEDVALUE(
        'Справка_порты_прочее'[Порты]
    ) = "Прочее",
    CALCULATE(
        [Сумма_экспорт_масло],
        FILTER(
            ALL(
                'Справка_порты_прочее'[Порты]),
                RANKX(
                    ALL(
                        'Справка_порты_прочее'[Порты]),
                    [Сумма_экспорт_масло]) > 5
        )
    ),
    BLANK()
)
