Сумма_прочее_масло =
IF(
    SELECTEDVALUE(
        'Справка_экспортеры_прочее'[Компании]
    ) = "ПРОЧЕЕ",
    CALCULATE(
        [Сумма_экспорт_масло],
        FILTER(
            ALL(
                'Справка_экспортеры_прочее'[Компании]),
                RANKX(
                    ALL(
                        'Справка_экспортеры_прочее'[Компании]),
                    [Сумма_экспорт_масло]) > 5
        )
    ),
    BLANK()
)
