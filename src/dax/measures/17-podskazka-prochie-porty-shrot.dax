Подсказка_прочие_порты_шрот =
"Всего "
&
IF(
    SELECTEDVALUE('Справка_порты_прочее'[Порты]) = "Прочее",
    CALCULATE(
        DISTINCTCOUNT('Справка_порты_прочее'[Порты]),
        FILTER(
            ALL('Справка_порты_прочее'[Порты]),
            RANKX(ALL('Справка_порты_прочее'[Порты]), [Сумма_экспорт_шрот]) > 5
        )
    )-1 & " а, именно: ",
    BLANK()
)
&
IF(
    SELECTEDVALUE('Справка_порты_прочее'[Порты]) = "Прочее",
    CALCULATE(
        CONCATENATEX(
            ADDCOLUMNS(
                'Справка_порты_прочее',
                "Без прочего",
                IF('Справка_порты_прочее'[Порты] = "Прочее", BLANK(), 'Справка_порты_прочее'[Порты])
            ),
            [Без прочего],
            ", "
        ),
        FILTER(
            ALL('Справка_порты_прочее'[Порты]),
            RANKX(ALL('Справка_порты_прочее'[Порты]), [Сумма_экспорт_шрот]) > 5
        )
    ),
    BLANK()
)
